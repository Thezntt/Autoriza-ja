# Banco e cache
DATABASE_URL=postgresql://autorizaja:autorizaja@localhost:5432/autorizaja
REDIS_URL=redis://localhost:6379

# Autenticação (troque por valores longos e aleatórios)
JWT_SECRET=troque-me
JWT_REFRESH_SECRET=troque-me-tambem

# Armazenamento de anexos (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=autorizaja-anexos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Notificações
SMTP_HOST=localhost
SMTP_PORT=1025
WHATSAPP_TOKEN=

# Integração com o sistema de gestão da operadora: rest | visao
ERP_ADAPTER=rest
ERP_URL=
